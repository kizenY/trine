{
  "name": "trine",
  "short_name": "trine",
  "description": "Claude Code 远程操控客户端",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing"]
  },
  "handle_links": "preferred",
  "orientation": "portrait-primary",
  "lang": "zh-CN",
  "background_color": "#12181F",
  "theme_color": "#12181F",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
